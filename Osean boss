package com.aistudio.dc27mission.data

import com.google.firebase.ai.FirebaseAI
import com.google.firebase.ai.type.GenerativeModel
import com.google.firebase.ai.type.content

class DC27GeminiMasterEngine {

    private val masterModel = FirebaseAI.getInstance().getGenerativeModel(
        modelName = "gemini-1.5-pro",
        systemInstruction = content {
            text("""
                You are DC-27: The Ultimate APPSC Group-I AI Institute, Examiner Analyst & Personal Mentor for Telugu Aspirants.
                Your duties:
                1. Teach any topic in simple Telugu with real-life examples, English terminology, Articles, and Core Concepts.
                2. Explain APPSC Examiner Traps, PYQ trends, and student confusion areas.
                3. Provide step-by-step Maths & Reasoning guidance for absolute beginners.
                4. Evaluate Mains answers with Structure, AP-specific context, and improvement points.
                Never hallucinate official PYQs; clearly label AI practice questions vs Official PYQs.
            """.trimIndent())
        }
    )

    suspend fun teachTopic(topicName: String): Result<String> {
        val prompt = "Topic: '$topicName'. Provide Basic to Advanced APPSC Examiner Level Explanation in Telugu with Real-life Examples, 10th Schedule/Articles, and Trap Areas."
        return callModel(prompt)
    }

    suspend fun analyzeExaminerMindset(topicName: String): Result<String> {
        val prompt = "Analyze APPSC Examiner Mindset for topic '$topicName'. Show PYQ trends, tricky statement patterns, and confusion options."
        return callModel(prompt)
    }

    suspend fun solveMathsStepByStep(problemText: String): Result<String> {
        val prompt = "Solve this Maths/Reasoning problem for a beginner: '$problemText'. Show concept, formula justification, step-by-step calculation, and easy tricks."
        return callModel(prompt)
    }

    suspend fun evaluateMainsAnswer(question: String, userDraft: String): Result<String> {
        val prompt = "Evaluate this APPSC Mains Answer.\nQuestion: $question\nStudent Draft: $userDraft\nProvide feedback on Intro, Body, Conclusion, AP Examples, and Marks Range."
        return callModel(prompt)
    }

    private suspend fun callModel(prompt: String): Result<String> {
        return try {
            val response = masterModel.generateContent(prompt)
            Result.success(response.text ?: "No response generated.")
        } catch (e: Exception) {
            Result.failure(e)
        }
    }
}

